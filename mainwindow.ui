                  <property name="class" stdset="0">
                   <string>cardSubtext</string>
                  </property>
                  <property name="text">
                   <string>Primary Domain Name Server</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
            </layout>
           </item>
           <!-- ROW 2: FULL-WIDTH EXPANDED NETWORK OVERVIEW -->
           <item>
            <widget class="QFrame" name="cardOverview">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
               <horstretch>0</horstretch>
               <verstretch>1</verstretch>
              </sizepolicy>
             </property>
             <layout class="QVBoxLayout" name="overviewLayout">
              <property name="leftMargin">
               <number>20</number>
              </property>
              <property name="topMargin">
               <number>18</number>
              </property>
              <property name="rightMargin">
               <number>20</number>
              </property>
              <property name="bottomMargin">
               <number>18</number>
              </property>
              <!-- Overview Header -->
              <item>
               <layout class="QHBoxLayout" name="overviewHeaderLayout">
                <item>
                 <widget class="QLabel" name="lblOverviewTitle">
                  <property name="class" stdset="0">
                   <string>cardHeader</string>
                  </property>
                  <property name="text">
                   <string>Network Throughput &amp; Telemetry</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <spacer name="spOverviewHeader">
                  <property name="orientation">
                   <enum>Qt::Orientation::Horizontal</enum>
                  </property>
                 </spacer>
                </item>
                <item>
                 <widget class="QLabel" name="lblOverviewStatus">
                  <property name="text">
                   <string>● Live Telemetry</string>
                  </property>
                  <property name="styleSheet">
                   <string notr="true">color: #16a34a; font-weight: 600; font-size: 11px;</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <!-- Graph & Rates Row -->
              <item>
               <layout class="QHBoxLayout" name="graphAndRatesLayout">
                <property name="spacing">
                 <number>20</number>
                </property>
                <!-- Large Expanded Graph placeholder -->
                <item>
                 <layout class="QVBoxLayout" name="graphPlaceholderLayout"/>
                </item>
                <!-- Metrics Column -->
                <item>
                 <layout class="QVBoxLayout" name="ratesLayout">
                  <property name="spacing">
                   <number>20</number>
                  </property>
                  <item>
                   <spacer name="spRatesTop">
                    <property name="orientation">
                     <enum>Qt::Orientation::Vertical</enum>
                    </property>
                   </spacer>
                  </item>
                  <!-- Down Metric -->
                  <item>
                   <layout class="QVBoxLayout" name="downMetricLayout">
                    <property name="spacing">
                     <number>3</number>
                    </property>
                    <item>
                     <widget class="QLabel" name="lblDownRate">
                      <property name="minimumSize">
                       <size>
                        <width>130</width>
                        <height>0</height>
                       </size>
                      </property>
                      <property name="text">
                       <string>↓ 12.4 Mbps</string>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">color: #2563eb; font-size: 19px; font-weight: 800;</string>
                      </property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QLabel" name="lblDownTag">
                      <property name="class" stdset="0">
                       <string>cardLabel</string>
                      </property>
                      <property name="text">
                       <string>DOWNLOAD RATE</string>
                      </property>
                     </widget>
                    </item>
                   </layout>
                  </item>
                  <!-- Up Metric -->
                  <item>
                   <layout class="QVBoxLayout" name="upMetricLayout">
                    <property name="spacing">
                     <number>3</number>
                    </property>
                    <item>
                     <widget class="QLabel" name="lblUpRate">
                      <property name="minimumSize">
                       <size>
                        <width>130</width>
                        <height>0</height>
                       </size>
                      </property>
                      <property name="text">
                       <string>↑ 8.1 Mbps</string>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">color: #9333ea; font-size: 19px; font-weight: 800;</string>
                      </property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QLabel" name="lblUpTag">
                      <property name="class" stdset="0">
                       <string>cardLabel</string>
                      </property>
                      <property name="text">
                       <string>UPLOAD RATE</string>
                      </property>
                     </widget>
                    </item>
                   </layout>
                  </item>
                  <item>
                   <spacer name="spRatesBottom">
                    <property name="orientation">
                     <enum>Qt::Orientation::Vertical</enum>
                    </property>
                   </spacer>
                  </item>
                 </layout>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
          </layout>
         </widget>
         <!-- PAGE 1: PACKET ANALYZER (WIRESHARK 3-PANE SUITE) -->
         <widget class="QWidget" name="pagePackets">
          <layout class="QVBoxLayout" name="pagePacketsLayout">
           <property name="spacing">
            <number>10</number>
           </property>
           <!-- Capture & Filter Toolbar Card -->
           <item>
            <widget class="QFrame" name="cardPacketControls">
             <layout class="QVBoxLayout" name="packetControlsLayout">
              <property name="leftMargin"><number>14</number></property>
              <property name="topMargin"><number>10</number></property>
              <property name="rightMargin"><number>14</number></property>
              <property name="bottomMargin"><number>10</number></property>
              <!-- Top Buttons Row -->
              <item>
               <layout class="QHBoxLayout" name="toolbarButtonsLayout">
                <property name="spacing"><number>8</number></property>
                <item>
                 <widget class="QPushButton" name="btnCaptureStart">
                  <property name="text"><string>Start Capture</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #10b981; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="btnCaptureStop">
                  <property name="text"><string>Stop</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #ef4444; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="btnCaptureRestart">
                  <property name="text"><string>Restart</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #f1f5f9; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="btnCaptureClear">
                  <property name="text"><string>Clear</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #f1f5f9; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QComboBox" name="comboCaptureIface">
                  <property name="minimumSize"><size><width>160</width><height>0</height></size></property>
                 </widget>
                </item>
                <item>
                 <spacer name="spToolbarRight">
                  <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
                 </spacer>
                </item>
                <item>
                 <widget class="QPushButton" name="btnOpenPcap">
                  <property name="text"><string>Import PCAP</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #f8fafc; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="btnSavePcap">
                  <property name="text"><string>Export PCAP</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #f8fafc; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QLabel" name="lblPacketStatus">
                  <property name="text"><string>Packets: 0 | Displayed: 0</string></property>
                  <property name="styleSheet"><string notr="true">color: #475569; font-weight: 600; font-size: 11px; padding: 5px 12px; background: #f1f5f9; border-radius: 12px;</string></property>
                 </widget>
                </item>
               </layout>
              </item>
              <!-- Display Filter Row (Classic Wireshark Filter Bar) -->
              <item>
               <layout class="QHBoxLayout" name="filterBarLayout">
                <property name="spacing"><number>8</number></property>
                <item>
                 <widget class="QLabel" name="lblFilterTag">
                  <property name="text"><string>Filter:</string></property>
                  <property name="styleSheet"><string notr="true">font-weight: 700; color: #475569;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QLineEdit" name="editPacketFilter">
                  <property name="placeholderText"><string>Display filter (e.g. tcp, udp, dns, icmp, port 443, ip 172.20.10.4)</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #ffffff; border: 1px solid #94a3b8; border-radius: 6px; padding: 6px 10px; font-family: 'Consolas', monospace; font-size: 12px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="btnApplyFilter">
                  <property name="text"><string>Apply</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #2563eb; color: white; font-weight: 600; border-radius: 6px; padding: 6px 14px;</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="btnClearFilter">
                  <property name="text"><string>Reset</string></property>
                  <property name="styleSheet"><string notr="true">background-color: #f1f5f9; color: #475569; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 14px;</string></property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <!-- Signature Wireshark 3-Pane Splitter -->
           <item>
            <widget class="QSplitter" name="splitterPanes">
             <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
             <property name="handleWidth"><number>6</number></property>
             <!-- PANE 1 (TOP): PACKET LIST TABLE -->
             <widget class="QTableWidget" name="tablePackets">
              <property name="columnCount"><number>7</number></property>
              <column><property name="text"><string>No.</string></property></column>
              <column><property name="text"><string>Time</string></property></column>
              <column><property name="text"><string>Source</string></property></column>
              <column><property name="text"><string>Destination</string></property></column>
              <column><property name="text"><string>Protocol</string></property></column>
              <column><property name="text"><string>Length</string></property></column>
              <column><property name="text"><string>Info</string></property></column>
             </widget>
             <!-- PANE 2 (MIDDLE): PACKET DETAILS TREE -->
             <widget class="QTreeWidget" name="treePacketDetails">
              <column><property name="text"><string>Packet Details (Hierarchical Protocol Dissection)</string></property></column>
             </widget>
             <!-- PANE 3 (BOTTOM): PACKET BYTES (HEX DUMP & ASCII) -->
             <widget class="QPlainTextEdit" name="txtPacketHex">
              <property name="readOnly"><bool>true</bool></property>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>
