  <property name="styleSheet">
   <string notr="true">
/* Global Reset and Colors */
QMainWindow {
    background-color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #0f172a;
}

QLabel {
    background: transparent;
    border: none;
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: transparent;
}

/* Left Sidebar */
#leftSidebar {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}

#brandTitle {
    color: #0f172a;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

#brandSubtitle {
    color: #64748b;
    font-size: 10px;
    font-weight: 600;
}

QLabel.sidebarSection {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    padding-left: 10px;
    padding-top: 14px;
    padding-bottom: 2px;
    letter-spacing: 0.8px;
}

QPushButton.navBtn {
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.navBtn:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QPushButton.navBtn:checked {
    background-color: #f1f5f9;
    color: #0f172a;
    font-weight: 600;
    border: 1px solid #e2e8f0;
}

#statusPillCard {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 6px 10px;
}

#lblClockPill {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 6px 14px;
    color: #334155;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Consolas', 'Segoe UI', monospace;
}

/* Distinct Card Backgrounds and Borders */
QFrame#cardIp, QFrame#cardGateway, QFrame#cardDns,
QFrame#cardOverview, QFrame#cardPacketControls,
QFrame#cardToolsControl, QFrame#cardToolsOutput, QFrame#cardHostsToolbar, QFrame#cardPortsFilter,
QFrame#cardSettingsForm {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QFrame#cardIp:hover, QFrame#cardGateway:hover, QFrame#cardDns:hover,
QFrame#cardOverview:hover {
    border-color: #cbd5e1;
}

QLabel.cardHeader {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.2px;
}

QLabel.cardLabel {
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.5px;
}

QLabel.cardValueMedium {
    font-size: 19px;
    font-weight: 700;
    color: #0f172a;
    font-family: 'Consolas', 'Segoe UI', monospace;
}

QLabel.cardSubtext {
    font-size: 11px;
    font-weight: 500;
    color: #94a3b8;
}

QPushButton.pillBtnPrimary {
    background-color: #0f172a;
    color: #ffffff;
    border: 1px solid #0f172a;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton.pillBtnPrimary:hover {
    background-color: #1e293b;
    border-color: #1e293b;
}

QPushButton.pillBtnSecondary {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton.pillBtnSecondary:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #f8fafc;
    selection-background-color: #f1f5f9;
    selection-color: #0f172a;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 7px 10px;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.3px;
}

/* Form Controls */
QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    color: #0f172a;
    font-size: 12px;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #2563eb;
}

/* Wireshark 3-Pane Styles */
#treePacketDetails {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 12px;
    color: #0f172a;
}

#treePacketDetails::item {
    padding: 3px 6px;
    color: #0f172a;
}

#treePacketDetails::item:hover {
    background-color: #f8fafc;
}

#treePacketDetails::item:selected {
    background-color: #f1f5f9;
    color: #0f172a;
}

#txtPacketHex {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-family: 'Consolas', 'Cascadia Code', monospace;
    font-size: 11px;
    color: #0f172a;
    padding: 8px;
}
